PORT=5000
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/attari

# با npm install به‌صورت خودکار دو مقدار امن و متفاوت ساخته می‌شود
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

CLIENT_ORIGIN=http://localhost:5173

# --- SEO ---
# آدرس عمومی و canonical سایت، بدون / آخر. در پرودکشن حتماً دامنه‌ی واقعی: https://kalavaran.ir
# لینک‌های داخل ایمیل (تأیید ایمیل، بازیابی رمز، سفارش) هم از همین آدرس ساخته می‌شوند.
SITE_URL=http://localhost:5173
# اجازه‌ی ایندکس گوگل. در staging/preview حتماً false (robots.txt همه‌چیز را Disallow می‌کند).
# اگر خالی باشد: فقط در NODE_ENV=production فعال است.
SEO_ALLOW_INDEXING=
# ریدایرکت 301 همه‌ی درخواست‌ها به دامنه/پروتکل SITE_URL (www → بدون www، http → https)
SEO_REDIRECT_TO_CANONICAL_HOST=false
# (اختیاری) صفحات رسمی شبکه‌های اجتماعی برای Organization.sameAs، با کاما جدا
SEO_SAME_AS=

# ادمین محیط توسعه، هرگز commit نکنید
# ADMIN_PASSWORD عمداً خالی است: npm install یک رمز تصادفی قوی می‌سازد و یک‌بار در ترمینال چاپ می‌کند.
# در پرودکشن رمز را فقط از پنل هاست (Render) تنظیم کنید.
ADMIN_EMAIL=admin@attari.local
ADMIN_PASSWORD=
ADMIN_PHONE=09120000000

# اختیاری، خالی بگذارید تا آپلود محلی انجام شود
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SHIPPING_FLAT=49000
FREE_SHIPPING_THRESHOLD=1000000

# --- Email (SMTP) ---
# اگر SMTP_HOST خالی باشد، ایمیلی ارسال نمی‌شود و در توسعه متن ایمیل (با لینک‌ها) در ترمینال چاپ می‌شود.
# نمونه‌ها: سرور ایمیل هاست خودتان (mail.kalavaran.ir)، Brevo (smtp-relay.brevo.com)، Zoho، Gmail (با App Password)
SMTP_HOST=
# 587 = STARTTLS، 465 = SSL
SMTP_PORT=587
# خالی = خودکار (برای پورت 465 true)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# فرستنده؛ دامنه‌اش باید SPF/DKIM معتبر داشته باشد وگرنه ایمیل‌ها به اسپم می‌روند
MAIL_FROM="کالاوران <no-reply@kalavaran.ir>"
# (اختیاری) پاسخ مشتری به این آدرس برود
MAIL_REPLY_TO=info@kalavaran.ir
# گیرنده‌های هشدار سفارش جدید و پیام‌های تماس با ما، با کاما جدا. خالی = ADMIN_EMAIL
MAIL_ADMIN_TO=
