# آدرس API.
#
# دو گزینه:
#   ۱. /api                        → از proxy داخلی ویت استفاده می‌کند (توصیه‌شده در توسعه).
#      در این حالت مرورگر همه‌چیز را same-origin می‌بیند: بدون preflight اضافه
#      و بدون دردسر کوکی cross-site. تنظیم proxy در vite.config.js است.
#
#   ۲. http://localhost:5000/api   → تماس مستقیم با بک‌اند.
#      در این حالت CLIENT_ORIGIN در backend/.env باید آدرس فرانت را داشته باشد.
VITE_API_URL=/api

# --- SEO ---
# آدرس عمومی سایت (همان SITE_URL بک‌اند). اگر خالی باشد، origin مرورگر استفاده می‌شود.
VITE_SITE_URL=
# (اختیاری) لینک شبکه‌های اجتماعی فوتر (آدرس کامل https://…).
# خالی = آیکن اصلاً نمایش داده نمی‌شود (لینک مرده href="#" حذف شد).
# واتس‌اپ اگر خالی باشد از شماره‌ی تلفن سایت ساخته می‌شود: https://wa.me/989027403331
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TELEGRAM=
VITE_SOCIAL_WHATSAPP=
